<?xml version="1.0" encoding="utf-8"?>
<!-- 大屏（sw>=600dp：车机宽屏、折叠屏展开后）版布局：左右分栏，插件
     容器在右边。默认的 layout/activity_knob.xml 是手机竖屏（上下堆叠），
     单独建这份文件是为了让大屏设备（不管方向）都走这套横向分栏，
     不会命中默认那份手机布局——折叠屏展开后哪怕还是竖屏方向，也会
     优先命中这份，因为 sw600dp 这个尺寸限定符比方向限定符优先级高。
     跟默认布局用的是同一套 view id/控件类型，改这份文件时留意
     layout/activity_knob.xml 是不是也要跟着改（目前项目规模小，两份
     布局各自独立维护，先接受这点重复）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- ==================== 左列：日志（上方）+ 按钮（底部） ==================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <!-- 日志区（占满左列上部） -->
        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:background="#F5F5F5"
            android:textColor="#1A1A1A"
            android:textColorHighlight="#4D4D4D"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:gravity="top" />

        <!-- 按钮区：三个可爱 emoji 大按钮（日志下方） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp">

            <LinearLayout
                android:id="@+id/btnPickPlugin"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_blue"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📥"
                    android:textSize="38sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选择插件"
                    android:textSize="11sp"
                    android:textColor="#1565C0"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnClearLog"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_orange"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧹"
                    android:textSize="38sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="清空日志"
                    android:textSize="11sp"
                    android:textColor="#E65100"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSaveLog"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_green"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💾"
                    android:textSize="38sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="保存日志"
                    android:textSize="11sp"
                    android:textColor="#2E7D32"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 权限申请按钮行：子按钮由 KnobActivity 按 PlatformConfig 动态生成
             （一行内平分；各平台带哪些权限、图标/文案全由 PlatformConfig 决定，
             布局里不写死任何平台专属权限）。颜色随权限状态变化（见
             KnobActivity.updatePermButtonState）。 -->
        <LinearLayout
            android:id="@+id/permContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- ==================== 右列：插件页面容器（未加载时显示占位符） ==================== -->
    <FrameLayout
        android:id="@+id/pluginContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="#FFFFFF">

        <!-- 占位符：插件 bindContainer 渲染时会 removeAllViews 清掉它 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎛️"
                android:textSize="56sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="插件页面"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加载并选择插件后，这里将显示插件的内容"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
