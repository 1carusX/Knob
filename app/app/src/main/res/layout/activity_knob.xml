<?xml version="1.0" encoding="utf-8"?>
<!-- 窄布局：Knob 窗口宽度 < 960dp——车机分屏（半屏约 640dp）、手机竖屏，也是
     没有其它限定符命中时的兜底。宽布局见 layout-w960dp。
     插件区占满宽度；日志收成底部一条（最新一条 + 未读错误数），点一下拉成
     抽屉盖住插件区下半部分。顶栏的状态胶囊只写"插件""蓝牙"，导入按钮只留
     图标。控件 id 跟宽布局一致，KnobActivity 共用一份代码。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ==================== 顶栏 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/surface_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_knob_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-condensed"
                android:text="Knob"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/pluginChip"
                style="@style/KnobChip"
                android:layout_marginStart="12dp">

                <View
                    android:id="@+id/pluginDot"
                    style="@style/KnobChipDot" />

                <TextView
                    android:id="@+id/pluginChipText"
                    style="@style/KnobChipText" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btChip"
                style="@style/KnobChip"
                android:layout_marginStart="8dp">

                <View
                    android:id="@+id/btDot"
                    style="@style/KnobChipDot" />

                <TextView
                    android:id="@+id/btChipText"
                    style="@style/KnobChipText" />

                <TextView
                    android:id="@+id/btGrant"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="-8dp"
                    android:background="@drawable/bg_pill_error"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="授权"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/btnImport"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_secondary"
                android:clickable="true"
                android:contentDescription="导入插件"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_import"
                    android:tint="@color/text" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- ==================== 插件区 ==================== -->
        <FrameLayout
            android:id="@+id/pluginContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel">

            <include
                android:id="@+id/emptyState"
                layout="@layout/plugin_empty" />
        </FrameLayout>

        <!-- ==================== 底部日志条：最新一条，点开是抽屉 ==================== -->
        <LinearLayout
            android:id="@+id/logStrip"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="12dp"
            android:background="@drawable/bg_log_strip"
            android:clickable="true"
            android:contentDescription="展开日志"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_log"
                android:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/logTicker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/logBadge"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:minWidth="22dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:src="@drawable/ic_chevron_up"
                android:tint="@color/text_body" />
        </LinearLayout>
    </LinearLayout>

    <!-- 抽屉拉开时盖在插件区上的遮罩，点一下收起；顶栏不盖 -->
    <View
        android:id="@+id/logScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="65dp"
        android:background="@color/scrim"
        android:clickable="true"
        android:contentDescription="收起日志"
        android:focusable="false"
        android:visibility="gone" />

    <!-- 高度在 KnobActivity 里按窗口高度设（约六成） -->
    <include
        android:id="@+id/logPanel"
        layout="@layout/log_panel"
        android:layout_width="match_parent"
        android:layout_height="430dp"
        android:layout_gravity="bottom"
        android:visibility="gone" />
</FrameLayout>
