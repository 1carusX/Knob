<?xml version="1.0" encoding="utf-8"?>
<!-- 默认布局：手机竖屏（也是没有其它限定符能命中时的兜底，包括折叠屏
     折起来的窄屏）。上下堆叠，插件容器拿大头空间（权重 7），日志/按钮
     这个开发调试面板缩到下面一小块（权重 3），日志区自己再滚动。
     另一份变体：
       layout-sw600dp/   大屏（车机宽屏、折叠屏展开后，不管方向）：
                         左右分栏，跟这份用的是同一套 view id/控件类型，
                         ViewBinding 才能共用同一个 ActivityKnobBinding，
                         KnobActivity.kt 不用为不同屏幕分别写代码。
                         折叠屏展开后哪怕还是竖屏方向，只要最小宽度
                         >=600dp 就会优先命中它而不是这份——sw600dp
                         这个尺寸限定符比方向限定符优先级更高。
     改这份文件时留意 layout-sw600dp 是不是也要跟着改。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- ==================== 上：插件页面容器（未加载时显示占位符） ==================== -->
    <FrameLayout
        android:id="@+id/pluginContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7"
        android:background="#FFFFFF">

        <!-- 占位符：插件 bindContainer 渲染时会 removeAllViews 清掉它 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎛️"
                android:textSize="56sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="插件页面"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加载并选择插件后，这里将显示插件的内容"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ==================== 下：日志 + 按钮（开发调试面板） ==================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <!-- 日志区（占满调试面板的剩余高度，自己滚动） -->
        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:background="#F5F5F5"
            android:textColor="#1A1A1A"
            android:textColorHighlight="#4D4D4D"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:gravity="top" />

        <!-- 按钮区：三个可爱 emoji 大按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp">

            <LinearLayout
                android:id="@+id/btnPickPlugin"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_blue"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📥"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选择插件"
                    android:textSize="11sp"
                    android:textColor="#1565C0"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnClearLog"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_btn_orange"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧹"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="清空日志"
                    android:textSize="11sp"
                    android:textColor="#E65100"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSaveLog"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_green"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💾"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="保存日志"
                    android:textSize="11sp"
                    android:textColor="#2E7D32"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 权限申请按钮行：子按钮由 KnobActivity 按 PlatformConfig 动态生成
             （一行内平分；各平台带哪些权限、图标/文案全由 PlatformConfig 决定，
             布局里不写死任何平台专属权限）。颜色随权限状态变化（见
             KnobActivity.updatePermButtonState）。 -->
        <LinearLayout
            android:id="@+id/permContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp" />
    </LinearLayout>
</LinearLayout>
