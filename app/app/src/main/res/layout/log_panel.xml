<?xml version="1.0" encoding="utf-8"?>
<!-- 日志面板，宽屏（layout-w960dp）是右侧一栏、窄屏是底部抽屉，两边 include
     同一份。背景、拖动条、收起按钮由 KnobActivity 按宽窄设置。
     车机没有 adb，日志是唯一的观测手段（见 LogSink）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 窄屏抽屉顶上的拖动条（只是示意，点收起按钮或遮罩关闭） -->
    <View
        android:id="@+id/logHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_drag_handle"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="日志"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/logCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-condensed"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnAutoScroll"
            style="@style/KnobIconButton"
            android:contentDescription="自动滚到最新"
            android:src="@drawable/ic_autoscroll" />

        <ImageButton
            android:id="@+id/btnSaveLog"
            style="@style/KnobIconButton"
            android:contentDescription="保存日志"
            android:src="@drawable/ic_save" />

        <ImageButton
            android:id="@+id/btnClearLog"
            style="@style/KnobIconButton"
            android:contentDescription="清空日志"
            android:src="@drawable/ic_clear" />

        <ImageButton
            android:id="@+id/btnCloseLog"
            style="@style/KnobIconButton"
            android:contentDescription="收起日志"
            android:src="@drawable/ic_chevron_down"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/filterAll"
            style="@style/KnobSegment"
            android:text="全部" />

        <TextView
            android:id="@+id/filterIssues"
            style="@style/KnobSegment"
            android:layout_marginStart="6dp"
            android:text="警告和错误" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/text_body"
                android:textIsSelectable="true"
                android:textSize="12.5sp" />
        </ScrollView>

        <!-- 往上翻看旧日志时自动滚动暂停，出现这个按钮 -->
        <TextView
            android:id="@+id/btnBackToLatest"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_back_to_latest"
            android:drawableStart="@drawable/ic_arrow_down"
            android:drawablePadding="6dp"
            android:drawableTint="@color/text_body"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="回到最新"
            android:textColor="@color/text_body"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
